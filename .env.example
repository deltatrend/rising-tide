# Rising Tide Youth Advocacy — environment variable template.
# Copy to `.env.local` and fill in real values. NEVER commit a file with real values.
# Secrets must never be prefixed with NEXT_PUBLIC_. The contact email is public on purpose.

# ---------------------------------------------------------------------------
# LegiScan (server only)
# ---------------------------------------------------------------------------
# Public API key from https://legiscan.com/legiscan — 30,000 queries/month.
LEGISCAN_API_KEY=

# ---------------------------------------------------------------------------
# Database — Supabase Postgres (server only)
# ---------------------------------------------------------------------------
# Use the Supabase *transaction pooler* (port 6543) connection string so the
# app works on Vercel serverless functions. Prepared statements are disabled
# automatically in lib/db/client.ts when the pooler is detected.
DATABASE_URL=
# Optional: only needed by some Supabase tooling, not used by the app itself.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Scheduled synchronization (server only)
# ---------------------------------------------------------------------------
# Long random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 — cached legislative document blobs (server only, optional)
# ---------------------------------------------------------------------------
# If these are absent the app still works; document blobs simply are not cached.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# ---------------------------------------------------------------------------
# Public site configuration (safe to expose)
# ---------------------------------------------------------------------------
# Canonical production origin, no trailing slash.
# Set this to the host Vercel treats as primary, e.g.
# https://www.risingtideyouthadvocacy.com
# Sitemap, Open Graph, canonicals and JSON-LD all use this. Without it,
# production falls back to the vercel.app URL and search engines may index that.
NEXT_PUBLIC_SITE_URL=
# Public contact address shown on the About page. Optional; omit until you have one.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Set to "true" to visibly label fixture/demo data in the UI. Fixture rows are
# always labelled in the database as well; this never affects production data.
NEXT_PUBLIC_FIXTURE_MODE=false
