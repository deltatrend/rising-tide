{
  "name": "rising-tide-youth-advocacy",
  "version": "1.0.0",
  "private": true,
  "description": "Rising Tide Youth Advocacy — a free public civic-education platform tracking New York State water-policy legislation.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-topics": "tsx scripts/seed-topics.ts",
    "db:seed-fixtures": "tsx scripts/seed-fixtures.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:timings": "tsx scripts/db-timings.ts",
    "db:connections": "tsx scripts/db-connections.ts",
    "db:concurrency": "tsx scripts/db-concurrency.ts",
    "smoke:routes": "tsx scripts/smoke-routes.ts",
    "sync:legiscan": "tsx scripts/sync-legiscan.ts",
    "sync:legiscan:dry": "tsx scripts/sync-legiscan.ts --dry-run",
    "classify:rerun": "tsx scripts/reclassify.ts",
    "override": "tsx scripts/set-override.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
